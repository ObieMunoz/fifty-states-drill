# Copy to .env.local for `npm run dev`. On Vercel, set these in the project's
# Environment Variables. VITE_ ones are built into the page and are public;
# the rest are read only by the API functions.

# Connecting Supabase from Vercel's Marketplace sets SUPABASE_URL,
# SUPABASE_SECRET_KEY and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for you, and the
# build reads those; nothing below needs typing in that case.

# The browser listens to the room tables with these (Supabase → Project
# Settings → API). The publishable key can read the room tables and nothing else.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The API writes with these. The secret key bypasses row security: never
# prefix it with VITE_ and never commit it.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. When set, Vercel sends it with each cron request and
# api/keepalive.ts refuses calls without it.
CRON_SECRET=

# Rematch requests are push notifications, signed with a VAPID key pair. Make
# one with `npx web-push generate-vapid-keys`. The public key is built into the
# page (either name works); the private key is read only by the API. Leave
# both unset and the app offers no notifications at all.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, as a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
